{
	"name": "react-native-uws",
	"private": true,
	"version": "0.0.0",
	"description": "Embed a HTTP server to your React Native app",
	"scripts": {
		"code-check": "npm run type-check && npm run lint",
		"lint": "eslint",
		"package-builder": "package-builder",
		"prepare": "husky",
		"type-check": "tsc --build"
	},
	"workspaces": {
		"catalog": {
			"@audira/carbon-react-native": "1.0.8",
			"@audira/carbon-react-native-elements": "1.0.0",
			"@carbon/icons": "11.84.0",
			"react": "19.2.3",
			"react-native-builder-bob": "0.41.0",
			"react-native-safe-area-context": "5.10.1",
			"react-native-svg": "15.15.5",
			"react-native-svg-transformer": "1.5.3",
			"tsx": "4.23.15"
		},
		"packages": [
			"examples/*",
			"package",
			"package-builder"
		]
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@react-native-community/cli": "20.1.3",
		"@react-native/eslint-config": "0.85.3",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/bun": "1.4.2",
		"@types/node": "^24",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/react-native-web": "0.19.3",
		"@types/semver": "7.8.0",
		"eslint": "10.12.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-native": "^5.0.0",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"package-builder": "workspace:*",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0"
	},
	"engines": {
		"bun": "^1.4.x",
		"node": ">=24"
	}
}
